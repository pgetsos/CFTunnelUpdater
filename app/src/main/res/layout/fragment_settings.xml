<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_dark_theme" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/dark_theme" android:saveEnabled="false"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/theme_hint" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/theme_hint" android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintTop_toBottomOf="@id/switch_dark_theme" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/tv_access_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloudflare Access Group"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/theme_hint" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_account_id"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_access_group_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_account_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Account ID"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_access_group_id"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_account_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_access_group_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Access Group ID"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_access_group_key"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_access_group_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_access_group_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API Key"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_worker_store_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cloudflare Worker Settings"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_access_group_key" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_cf_worker_url"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_worker_store_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_cf_worker_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Worker base url"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_worker_api_key"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_cf_worker_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_worker_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API Key"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_options_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Options"
            android:textAppearance="?attr/textAppearanceHeadline6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_worker_api_key" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_auto_update"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Auto-Update"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_options_title" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_replace_auto" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Replace this phone’s previous auto-added IP"
            app:layout_constraintTop_toBottomOf="@id/switch_auto_update" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/auto_explanation" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Checks while the app is open and periodically in the background (15 minutes or later). Replacement tracking stays on this phone. Existing entries are never claimed as auto-added."
            app:layout_constraintTop_toBottomOf="@id/switch_replace_auto" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_background_monitor" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Monitor network changes in background"
            app:layout_constraintTop_toBottomOf="@id/auto_explanation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/background_explanation" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Shows an ongoing notification. Checks after Wi-Fi/mobile changes or reconnecting. Periodic checks still catch router IP changes. Reopen the app after reboot or force-stop. Android may delay checks."
            app:layout_constraintTop_toBottomOf="@id/switch_background_monitor" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <Button android:id="@+id/setup_guide" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Setup guide" app:layout_constraintTop_toBottomOf="@id/background_explanation" app:layout_constraintStart_toStartOf="parent" />
        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/setup_guide" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>